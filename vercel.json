{
  "rewrites": [
    {
      "source": "/api-contaazul/:path*",
      "destination": "https://api-v2.contaazul.com/:path*"
    },
    {
      "source": "/api-ca-v1/:path*",
      "destination": "https://api.contaazul.com/:path*"
    },
    {
      "source": "/((?!api-contaazul|api-ca-v1).*)",
      "destination": "/index.html"
    }
  ]
}
